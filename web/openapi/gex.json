  "info": {
    "title": "LocalRithmicLLM GEX",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/bars": {
      "get": {
        "description": "Recent bars, oldest first, including the one still forming; optionally within [start_ns, end_ns).",
        "operationId": "recent_bars_bars_get",
        "parameters": [
          {
            "in": "query",
            "name": "underlying",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Underlying"
            }
          },
          {
            "in": "query",
            "name": "interval",
            "required": false,
            "schema": {
              "default": "1m",
              "enum": [
                "1m",
                "5m",
                "15m",
                "1h",
                "1d"
              ],
              "title": "Interval",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 300,
              "maximum": 20000,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "start_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start Ns"
            }
          },
          {
            "in": "query",
            "name": "end_ns",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End Ns"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Bar"
                  },
                  "title": "Response Recent Bars Bars Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Recent Bars"
      }
    },
    "/flow/dates": {
      "get": {
        "description": "Sessions with a replayed flow history for this future's ETF, oldest first.",
        "operationId": "flow_dates_flow_dates_get",
        "parameters": [
          {
            "in": "query",
            "name": "underlying",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Underlying"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "type": "string"
                  },
                  "title": "Response Flow Dates Flow Dates Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Flow Dates"
      }
    },
    "/flow/history": {
      "get": {
        "description": "Minute-by-minute flow nodes for one session, with the ETF-to-future price ratio for that day.\n\nskip_inside and skip_locked choose the trade filters (see FlowRules); both on by default.",
        "operationId": "flow_history_flow_history_get",
        "parameters": [
          {
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "title": "Date",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "underlying",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Underlying"
            }
          },
          {
            "in": "query",
            "name": "skip_inside",
            "required": false,
            "schema": {
              "default": true,
              "title": "Skip Inside",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "skip_locked",
            "required": false,
            "schema": {
              "default": true,
              "title": "Skip Locked",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowHistoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Flow History"
      }
    },
    "/flow/live": {
      "get": {
        "description": "Today's live flow so far: one frame per market minute (or per 10 seconds with\nstream=true), the last one still updating.",
        "operationId": "flow_live_flow_live_get",
        "parameters": [
          {
            "in": "query",
            "name": "underlying",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Underlying"
            }
          },
          {
            "in": "query",
            "name": "skip_inside",
            "required": false,
            "schema": {
              "default": true,
              "title": "Skip Inside",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "skip_locked",
            "required": false,
            "schema": {
              "default": true,
              "title": "Skip Locked",
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "stream",
            "required": false,
            "schema": {
              "default": false,
              "title": "Stream",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FlowHistoryOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Flow Live"
      }
    },
