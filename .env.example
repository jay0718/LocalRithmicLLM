# Console
CONSOLE_ADMIN_TOKEN=
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONSOLE_SECRET_KEY=
CONSOLE_DB_PATH=data/console.db

# Rithmic
# Unpacked R|Protocol kit, the folder containing proto/ and etc/
RITHMIC_KIT_DIR=/path/to/RProtocolAPI/0.87.0.0
RITHMIC_APP_NAME=LocalRithmicLLM
RITHMIC_APP_VERSION=0.1.0
RITHMIC_URI=wss://rituz00100.rithmic.com:443
# Lists every firm; no login is sent to this address by the firm picker
RITHMIC_SYSTEMS_URI=wss://rprotocol.rithmic.com:443
RITHMIC_SYSTEM_NAME="Rithmic Test"
RITHMIC_USER=you@example.com
RITHMIC_PASSWORD=your-password-here

# Local LLM backends
OLLAMA_PRIMARY_URL=
OLLAMA_FALLBACK_URL=

# Docker Compose
POSTGRES_PASSWORD=change-me
GRAFANA_ADMIN_PASSWORD=change-me
# Host ports, bound to 127.0.0.1
POSTGRES_PORT=15432
REDIS_PORT=16379
REDPANDA_PORT=19092
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000

# QQQ options overlay on NQ (end of day). Free Massive key works; open interest comes from OCC.
MASSIVE_API_KEY=
# MASSIVE_CALLS_PER_MINUTE=5
# EQUITY_OVERLAYS=NQ:QQQ
# EQUITY_EOD_EXPIRIES=4
# EQUITY_EOD_STRIKE_PCT=0.025
# EQUITY_EOD_DIR=data/eod

# Live QQQ flow nodes from Databento (needs a live plan with OPRA.PILLAR). Off when unset.
# FLOW_LIVE=databento
# DATABENTO_API_KEY=
# FLOW_LIVE_BAND=0.04
# FLOW_LIVE_CACHE=data/flow-raw/live-cache
